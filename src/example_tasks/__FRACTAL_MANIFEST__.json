      "args_schema_non_parallel": {
        "$defs": {
          "ModelWithCoupledFields": {
            "additionalProperties": false,
            "description": "Model demonstrating if/then/else coupled field constraints in JSON schema.",
            "else": {
              "properties": {
                "field_1_dependent": {
                  "const": 0
                }
              }
            },
            "if": {
              "properties": {
                "field_1": {
                  "const": true
                }
              }
            },
            "properties": {
              "field_1": {
                "default": false,
                "title": "Field 1",
                "type": "boolean",
                "description": "A boolean toggle controlling the constraint on field_1_dependent."
              },
              "field_1_dependent": {
                "default": 1,
                "description": "This field is dependent on field_1. If field_1 is False, this field should be set to 0. If field_1 is True, this field should be set to a positive integer.",
                "title": "Field 1 Dependent",
                "type": "integer"
              }
            },
            "then": {
              "properties": {
                "field_1_dependent": {
                  "minimum": 1
                }
              }
            },
            "title": "ModelWithCoupledFields",
            "type": "object"
          },
          "ModelWithDependentRequired": {
            "additionalProperties": false,
            "dependentRequired": {
              "enable_proxy": [
                "proxy_url",
                "proxy_port"
              ]
            },
            "description": "Model demonstrating dependentRequired constraints in JSON schema.",
            "properties": {
              "enable_proxy": {
                "default": false,
                "title": "Enable Proxy",
                "type": "boolean",
                "description": "Whether to enable the proxy. When set, proxy_url and proxy_port are required."
              },
              "proxy_url": {
                "default": "",
                "description": "URL of the proxy server.",
                "title": "Proxy Url",
                "type": "string"
              },
              "proxy_port": {
                "default": 8080,
                "description": "Port of the proxy server.",
                "maximum": 65535,
                "minimum": 1,
                "title": "Proxy Port",
                "type": "integer"
              }
            },
            "title": "ModelWithDependentRequired",
            "type": "object"
          },
          "ModelWithMultipleConditions": {
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "advanced"
                    }
                  }
                },
                "then": {
                  "required": [
                    "advanced_config"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "use_cache": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "cache_size": {
                      "minimum": 1
                    }
                  }
                }
              }
            ],
            "description": "Model demonstrating multiple independent coupled conditions via allOf in JSON schema.",
            "properties": {
              "mode": {
                "default": "simple",
                "enum": [
